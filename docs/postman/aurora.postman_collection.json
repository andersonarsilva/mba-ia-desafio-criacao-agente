{
  "info": {
    "name": "Residencial Aurora API",
    "description": "Fluxo do avaliador do assistente do Residencial Aurora. Rode `uv run aurora-restaurar` e `uv run aurora-api` e execute as pastas em ordem (Collection Runner). Contrato em docs/contrato-api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
