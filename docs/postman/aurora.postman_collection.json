      "description": "Rode `uv run aurora-restaurar` antes.",
      "item": [
        {
          "name": "Reservas do 101",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/apartamentos/101/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
