                "101",
                "reservas"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"RSV-1377\", () => pm.expect(pm.response.text()).to.include(\"RSV-1377\"));"
